rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function admin() {
      return signedIn() && (
        (('permissions' in profile()) && ('admin' in profile().permissions) && profile().permissions.admin == true) ||
        (('role' in profile()) && profile().role == 'admin')
      );
    }
    function seller() {
      return signedIn() && (
        admin() ||
        (('permissions' in profile()) && ('seller' in profile().permissions) && profile().permissions.seller == true) ||
        (('role' in profile()) && profile().role == 'seller')
      );
    }
    function validProjectStatus(data) {
      return data.status in ['draft', 'pending', 'approved', 'active', 'inactive', 'sold', 'rejected'];
    }
    function validProject(data) {
      return data.ownerId is string && data.ownerId.size() > 0
        && data.sellerUid is string && data.sellerUid == data.ownerId
        && data.name is string && data.name.size() >= 2
        && (!('display' in data) || (data.display is map && data.display.schemaVersion is int))
        && validProjectStatus(data);
    }
    function validFeedBanner(data) {
      return data.keys().hasOnly([
          'imageUrl', 'displayOrder', 'isActive', 'storagePath', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'imageUrl', 'displayOrder', 'isActive', 'storagePath', 'createdAt', 'updatedAt'
        ])
        && data.imageUrl is string
        && data.imageUrl.size() <= 2000
        && data.imageUrl.matches('https://firebasestorage.googleapis.com/.*')
        && data.storagePath is string
        && data.storagePath.matches('feed-banners/[a-f0-9-]+\\.(jpg|png|webp)')
        && data.displayOrder is int
        && data.displayOrder >= 1
        && data.displayOrder <= 5
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.permissions.buyer == true
        && request.resource.data.permissions.seller == false
        && request.resource.data.permissions.admin == false;
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update: if signedIn()
        && request.resource.data.permissions == resource.data.permissions
        && (admin() || request.auth.uid == userId);
      allow delete: if false;
    }

    match /sellerRequests/{requestId} {
      allow create: if signedIn() && request.auth.uid == requestId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (request.auth.uid == requestId || admin());
      allow update: if signedIn()
        && request.auth.uid == requestId
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read: if signedIn() && (resource.data.status == 'active' || admin() || resource.data.ownerId == request.auth.uid);
      allow create: if !admin()
        && seller()
        && validProject(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByRole == 'seller'
        && request.resource.data.status == 'pending';
      allow update: if (admin() && validProject(request.resource.data) && request.resource.data.status == resource.data.status)
        || (seller() && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && validProject(request.resource.data)
          && request.resource.data.status == 'pending');
      allow delete: if admin();
    }

    match /layouts/{layoutId} {
      allow read: if signedIn() && (
        admin() ||
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.status == 'active' ||
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid
      );
      allow create: if signedIn() && (
        admin() ||
        (seller() && request.resource.data.projectId != null &&
         get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.auth.uid)
      );
      allow update: if signedIn() && (
        admin() ||
        (seller() && resource.data.projectId != null &&
         get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid)
      );
      allow delete: if signedIn() && (
        admin() ||
        (seller() && resource.data.projectId != null &&
         get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid)
      );
    }

    match /propertyAuditLogs/{auditId} { allow read: if admin(); allow write: if false; }

    match /leads/{recordId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // Cheap ownership checks first, so the `get()` inside admin()/seller()
      // only runs when strictly necessary — keeps reads fast for normal users.
      allow read: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.projectOwnerId == request.auth.uid ||
        admin()
      );
      allow update: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if admin();
    }

    match /visits/{recordId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.projectOwnerId == request.auth.uid ||
        admin()
      );
      allow update: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if admin();
    }

    match /cashbacks/{recordId} {
      // Creation and every lifecycle transition are performed by transactional
      // callable functions so clients cannot forge amounts, timestamps or roles.
      allow create: if false;
      allow read: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.projectOwnerId == request.auth.uid ||
        admin()
      );
      allow update, delete: if false;
    }

    match /cashbackAuditLogs/{recordId} {
      allow read: if admin();
      allow write: if false;
    }

    match /notifications/{recordId} {
      allow read: if signedIn() && (resource.data.recipientId == request.auth.uid || admin());
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }

    match /feed/{bannerId} {
      allow read: if signedIn() && (resource.data.isActive == true || admin());
      allow create: if admin() && validFeedBanner(request.resource.data);
      allow update: if admin()
        && validFeedBanner(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if admin();
    }
  }
}
