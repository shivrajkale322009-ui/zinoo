rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function admin() { return signedIn() && role() == 'admin'; }
    function seller() { return signedIn() && role() == 'seller'; }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == 'buyer';
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update: if signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if admin() || (seller() && request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if admin() || (seller() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId);
    }

    match /leads/{recordId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid) || (seller() && resource.data.projectOwnerId == request.auth.uid);
      allow update: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if admin();
    }

    match /visits/{recordId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid) || (seller() && resource.data.projectOwnerId == request.auth.uid);
      allow update: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if admin();
    }

    match /cashbacks/{recordId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid) || (seller() && resource.data.projectOwnerId == request.auth.uid);
      allow update: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if admin();
    }
  }
}
