rules_version = '2';

// featuredDevelopers model:
// sellerId/logo, experience and project counters,
// verified/sortIndex/isFeatured/isActive, createdAt/updatedAt.
// Buyer reads are authenticated and limited to active records; Admin owns CRUD.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function admin() {
      return signedIn() && (
        (('permissions' in profile()) && ('admin' in profile().permissions) && profile().permissions.admin == true) ||
        (('role' in profile()) && profile().role == 'admin')
      );
    }
    function seller() {
      return signedIn() && (
        admin() ||
        (('permissions' in profile()) && ('seller' in profile().permissions) && profile().permissions.seller == true) ||
        (('role' in profile()) && profile().role == 'seller')
      );
    }
    function validProjectStatus(data) {
      return data.status in ['draft', 'pending', 'approved', 'active', 'inactive', 'sold', 'rejected'];
    }
    function validProject(data) {
      return data.ownerId is string && data.ownerId.size() > 0
        // Older project records predate sellerUid. Preserve compatibility for
        // those records while enforcing equality whenever the field exists.
        && (!('sellerUid' in data) || (data.sellerUid is string && data.sellerUid == data.ownerId))
        && data.name is string && data.name.size() >= 2
        && (!('amenities' in data) || (data.amenities is list && data.amenities.size() <= 100))
        && (!('amenityIds' in data) || (data.amenityIds is list && data.amenityIds.size() <= 100))
        && (!('display' in data) || (data.display is map && data.display.schemaVersion is int))
        && validProjectStatus(data);
    }
    function validAmenityCatalog(data) {
      return data.keys().hasOnly(['name', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'isActive', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 80
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
    function validFeedBanner(data) {
      return data.keys().hasOnly([
          'imageUrl', 'displayOrder', 'isActive', 'storagePath', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'imageUrl', 'displayOrder', 'isActive', 'storagePath', 'createdAt', 'updatedAt'
        ])
        && data.imageUrl is string
        && data.imageUrl.size() <= 2000
        && data.imageUrl.matches('https://firebasestorage.googleapis.com/.*')
        && data.storagePath is string
        && data.storagePath.matches('feed-banners/[a-f0-9-]+\\.(jpg|png|webp)')
        && data.displayOrder is int
        && data.displayOrder >= 1
        && data.displayOrder <= 5
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
    function validFeaturedDeveloper(data) {
      return data.keys().hasOnly([
          'sellerId', 'logo', 'experienceYears',
          'completedProjects', 'activeProjects', 'upcomingProjects', 'verified',
          'sortIndex', 'isFeatured', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'sellerId', 'logo', 'experienceYears',
          'completedProjects', 'activeProjects', 'upcomingProjects', 'verified',
          'sortIndex', 'isFeatured', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.sellerId is string && data.sellerId.size() >= 20 && data.sellerId.size() <= 128
        && data.logo is string && data.logo.size() <= 2000 && data.logo.matches('https://.*')
        && data.experienceYears is int && data.experienceYears >= 0 && data.experienceYears <= 150
        && data.completedProjects is int && data.completedProjects >= 0 && data.completedProjects <= 10000
        && data.activeProjects is int && data.activeProjects >= 0 && data.activeProjects <= 10000
        && data.upcomingProjects is int && data.upcomingProjects >= 0 && data.upcomingProjects <= 10000
        && data.verified is bool
        && data.sortIndex is int && data.sortIndex >= 0 && data.sortIndex <= 1000
        && data.isFeatured is bool && data.isActive is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validUserCreate(data) {
      return data.keys().hasOnly([
          'uid', 'name', 'displayName', 'firstName', 'lastName', 'email', 'phone',
          'phoneNumber', 'permissions', 'createdAt', 'updatedAt', 'firstSignedInAt', 'lastSignedInAt'
        ])
        && data.keys().hasAll(['uid', 'email', 'permissions', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 254
        && data.permissions is map
        && data.permissions.keys().hasOnly(['buyer', 'seller', 'admin'])
        && data.permissions.buyer == true
        && data.permissions.seller == false
        && data.permissions.admin == false
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 60))
        && (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 60))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30))
        && (!('firstSignedInAt' in data) || data.firstSignedInAt is timestamp)
        && (!('lastSignedInAt' in data) || data.lastSignedInAt is timestamp);
    }
    function validUserAccountUpdate(data) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'firstName', 'lastName', 'phoneNumber', 'firstSignedInAt', 'lastSignedInAt', 'updatedAt'
        ])
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 60))
        && (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 60))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30))
        && (!('firstSignedInAt' in data) || data.firstSignedInAt is timestamp)
        && (!('lastSignedInAt' in data) || data.lastSignedInAt is timestamp)
        // Timestamp must be generated by Firestore's server clock, not chosen
        // by the buyer, whenever it is changed.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSignedInAt'])
          || data.lastSignedInAt == request.time)
        // A buyer can only initialize this field using the server clock;
        // once written it cannot be altered or removed.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['firstSignedInAt'])
          || (!('firstSignedInAt' in resource.data) && data.firstSignedInAt == request.time))
        && data.updatedAt is timestamp;
    }
    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && validUserCreate(request.resource.data);
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update: if signedIn() && (
        admin() || (request.auth.uid == userId && validUserAccountUpdate(request.resource.data))
      );
      allow delete: if signedIn() && (request.auth.uid == userId || admin());
    }

    match /sellerRequests/{requestId} {
      allow create: if signedIn() && request.auth.uid == requestId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (request.auth.uid == requestId || admin());
      allow update: if signedIn()
        && request.auth.uid == requestId
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && (request.auth.uid == requestId || admin());
    }

    match /projects/{projectId} {
      allow read: if signedIn() && (resource.data.status == 'active' || admin() || resource.data.ownerId == request.auth.uid);
      allow create: if !admin()
        && seller()
        && validProject(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByRole == 'seller'
        && request.resource.data.status == 'pending';
      allow update: if (admin() && validProject(request.resource.data) && request.resource.data.status == resource.data.status)
        || (seller() && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && validProject(request.resource.data)
          && request.resource.data.status == 'pending');
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.createdBy == request.auth.uid || admin());
    }

    // Admin-managed options only. Sellers can query active choices for their
    // own project editor; buyers never receive the master catalog.
    match /amenityCatalog/{amenityId} {
      allow read: if admin() || (seller() && resource.data.isActive == true);
      allow create: if admin() && validAmenityCatalog(request.resource.data);
      allow update: if admin()
        && validAmenityCatalog(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Sanitized, lifecycle-managed projections used by the public landing and
    // server-rendered SEO pages. Clients can never write these collections.
    match /publicProjects/{projectId} {
      allow read: if resource.data.publicVisibility == true
        && resource.data.status == 'active';
      allow write: if false;
    }
    match /publicLocations/{locationId} {
      allow read: if true;
      allow write: if false;
    }
    match /publicProjectSlugs/{slug} {
      allow read, write: if false;
    }

    match /layouts/{layoutId} {
      allow read: if
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.status == 'active' ||
        (signedIn() && (admin() ||
          get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid));
      allow create: if signedIn() && (
        admin() ||
        (seller() && request.resource.data.projectId != null &&
         get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.auth.uid)
      );
      allow update: if signedIn() && (
        admin() ||
        (seller() && resource.data.projectId != null &&
         get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid)
      );
      allow delete: if signedIn() && (
        admin() ||
        (seller() && (
          ('createdBy' in resource.data && resource.data.createdBy == request.auth.uid) ||
          (resource.data.projectId != null && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid)
        ))
      );
    }

    match /propertyAuditLogs/{auditId} { allow read: if admin(); allow write: if false; }

    match /leadImports/{importId} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['name', 'importedCount', 'duplicateCount', 'totalRows', 'uploadedAt', 'uploadedBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.importedCount is int && request.resource.data.importedCount >= 0 && request.resource.data.importedCount <= 400
        && request.resource.data.duplicateCount is int && request.resource.data.duplicateCount >= 0 && request.resource.data.duplicateCount <= 400
        && request.resource.data.totalRows is int && request.resource.data.totalRows > 0 && request.resource.data.totalRows <= 400
        && request.resource.data.importedCount + request.resource.data.duplicateCount == request.resource.data.totalRows
        && request.resource.data.uploadedAt is timestamp
        && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /leads/{recordId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // Cheap ownership checks first, so the `get()` inside admin()/seller()
      // only runs when strictly necessary — keeps reads fast for normal users.
      allow read: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.projectOwnerId == request.auth.uid ||
        admin()
      );
      allow update: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || ('userId' in resource.data && resource.data.userId == request.auth.uid) || admin());
    }

    match /visits/{recordId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.projectOwnerId == request.auth.uid ||
        admin()
      );
      allow update: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || ('userId' in resource.data && resource.data.userId == request.auth.uid) || admin());
    }

    match /cashbacks/{recordId} {
      // Creation and every lifecycle transition are performed by transactional
      // callable functions so clients cannot forge amounts, timestamps or roles.
      allow create: if false;
      allow read: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.projectOwnerId == request.auth.uid ||
        admin()
      );
      allow update, delete: if false;
    }

    match /cashbackAuditLogs/{recordId} {
      allow read: if admin();
      allow write: if false;
    }

    match /notifications/{recordId} {
      allow read: if signedIn() && (resource.data.recipientId == request.auth.uid || admin());
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create: if false;
      allow delete: if signedIn() && (resource.data.recipientId == request.auth.uid || ('userId' in resource.data && resource.data.userId == request.auth.uid) || admin());
    }

    match /feed/{bannerId} {
      allow read: if signedIn() && (resource.data.isActive == true || admin());
      allow create: if admin() && validFeedBanner(request.resource.data);
      allow update: if admin()
        && validFeedBanner(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if admin();
    }
    match /feedSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if admin() && settingId == 'home'
        && request.resource.data.keys().hasOnly(['enabled', 'updatedAt'])
        && request.resource.data.keys().hasAll(['enabled', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
    // Marketing campaigns contain lead phone numbers in recipient records.
    // The Functions backend owns all writes; the UI is strictly admin-only.
    match /whatsapp_templates/{templateId} { allow read: if admin(); allow write: if false; }
    match /whatsapp_campaigns/{campaignId} {
      allow read: if admin();
      allow write: if false;
      match /recipients/{recipientId} { allow read: if admin(); allow write: if false; }
    }
    match /featuredDevelopers/{developerId} {
      // Admin first: duplicate-check transactions must be able to read a
      // non-existent deterministic seller document before creating it.
      allow read: if admin() || (signedIn() && resource.data.isActive == true);
      allow create: if admin()
        && developerId == request.resource.data.sellerId
        && exists(/databases/$(database)/documents/users/$(request.resource.data.sellerId))
        && validFeaturedDeveloper(request.resource.data);
      allow update: if admin()
        && request.resource.data.sellerId == resource.data.sellerId
        && validFeaturedDeveloper(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if admin();
    }
  }
}
