+        return value
+            .replaceAll("\\+\\d[\\d\\s()\\-]{7,}\\d", "[phone redacted]")
+            .replaceAll("\\b\\d{6}\\b", "[code redacted]")
+            .replaceAll("\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\b", "[token redacted]")
+            .replaceAll("(?i)\\b(?:id|access|refresh)[ _-]?token\\s*[:=]\\s*\\S+", "[token redacted]")
+            .replaceAll("(?i)\\bcredential\\s*[:=]\\s*\\S+", "[credential redacted]");
+    }
