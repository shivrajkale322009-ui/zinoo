rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function publicProjectMedia(projectId) {
      return projectId != 'drafts'
        && firestore.exists(/databases/default/documents/publicProjects/$(projectId))
        && firestore.get(/databases/default/documents/publicProjects/$(projectId)).data.publicVisibility == true
        && firestore.get(/databases/default/documents/publicProjects/$(projectId)).data.status == 'active';
    }
    function admin() {
      return request.auth != null
        && (
          firestore.get(/databases/default/documents/users/$(request.auth.uid)).data.permissions.admin == true
          || firestore.get(/databases/default/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }
    match /cashback-claims/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|application/pdf');
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /project-documents/{uploaderId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uploaderId
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uploaderId;
    }

    // Draft uploads stay private. Published project media is publicly readable
    // only while its sanitized public projection is active.
    match /project-media/{uploaderId}/{projectId}/{allPaths=**} {
      allow read: if request.auth != null || publicProjectMedia(projectId);
      allow create: if request.auth != null
        && request.auth.uid == uploaderId
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp|video/mp4|video/webm');
      allow update: if false;
      allow delete: if request.auth != null && (request.auth.uid == uploaderId || admin());
    }

    match /feed-banners/{fileName} {
      allow read: if request.auth != null;
      // Feed assets are written only by manageFeedBannerAsset after it verifies
      // the caller against the named `default` Firestore database.
      allow write: if false;
    }

    match /developer-profile-logos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && fileName.matches('[0-9]+\\.(jpg|png|webp)')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
